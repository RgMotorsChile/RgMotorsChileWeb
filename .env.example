# --- Supabase (multi-tenant: RG Motors + Unidades Chile + Inventario) ---
NEXT_PUBLIC_SUPABASE_URL=https://tuybpizjeszgwtcvunmp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Obligatoria en el servidor (createServerSupabase lanza error si falta; no usa la anon key):
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_SHEET_ID=1BG2uR6APbXEMvVvRmdR-Nn0Vko6eobJ6Xam0XX41Ldc
# Tenant sheet tabs: RG MOTORS (este sitio) | UNIDADES CHILE (otro tenant)

# --- Obligatorias en producción Vercel ---
ADMIN_SESSION_SECRET=
CRON_SECRET=

# Documentos (app_documents), rate limit y fotos (bucket vehicle-photos).
# NEXT_PUBLIC_SUPABASE_URL ya apunta al proyecto RG si no se redefine.
# SUPABASE_SERVICE_ROLE_KEY es obligatoria en Vercel Production.
# No hace falta KV: Vercel queda solo como hosting.

# Token del Blob viejo. Ya no sube fotos. Solo lo usa la limpieza manual del admin.
# BLOB_READ_WRITE_TOKEN=

# URL canónica del sitio (actualizar a https://rgmotors.cl cuando el DNS esté listo)
NEXT_PUBLIC_SITE_URL=https://rg-motors.vercel.app

# Datos legales / empresa (recomendado antes de tráfico comercial)
# COMPANY_RUT=12.345.678-9
# COMPANY_LEGAL_NAME=RG Motors SpA
# COMPANY_EMAIL=administracion@rgmotorschile.cl

# --- Medición (opcional; sin valor no se carga nada) ---
# Google Analytics 4: ID del flujo web (G-XXXXXXXXXX). Solo carga en el sitio público y tras aceptar cookies.
# NEXT_PUBLIC_GA_ID=
# Google Search Console: solo el valor "content" de la meta google-site-verification.
# NEXT_PUBLIC_GSC_VERIFICATION=

# --- Email de leads (Resend) ---
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=RG Motors <noreply@rgmotorschile.cl>
# NOTIFY_EMAIL=administracion@rgmotorschile.cl

# --- Opcionales / debug ---
# NEXT_PUBLIC_BASE_PATH=/RGmotors
# GITHUB_PAGES=true
# ALLOW_DEFAULT_ADMIN_USER=1
# SECURITY_RELAX_ORIGIN=1
# FORCE_ORIGIN_CHECK=1
# CRON_ALLOW_QUERY_SECRET=1
# RG_PREFER_LOCAL_DATA=1

# --- Futuro (sin contrato WebPay aún) ---
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# WEBPAY_ENVIRONMENT=integration
